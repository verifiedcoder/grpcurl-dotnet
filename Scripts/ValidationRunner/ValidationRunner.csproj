<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GrpCurl.Net.ValidationRunner</RootNamespace>
    <AssemblyName>ValidationRunner</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**;manual-write-test\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
