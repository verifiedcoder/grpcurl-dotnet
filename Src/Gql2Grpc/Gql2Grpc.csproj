<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gql2Grpc</RootNamespace>
        <AssemblyName>Gql2Grpc</AssemblyName>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <InformationalVersion>1.0.0</InformationalVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>gql2grpc</ToolCommandName>
        <IsPackable>true</IsPackable>
        <PackageId>Gql2Grpc</PackageId>
        <Description>GraphQL-to-gRPC proxy CLI. Translates GraphQL queries into gRPC calls using a YAML mapping. Built on GrpCurl.Net.Core.</Description>
        <PackageTags>grpc;graphql;cli;dotnet-tool</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GrpCurl.Net.Core\GrpCurl.Net.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GraphQL-Parser" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Gql2Grpc.Tests" />
    </ItemGroup>

</Project>
