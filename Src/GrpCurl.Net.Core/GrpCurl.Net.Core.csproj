<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>GrpCurl.Net</RootNamespace>
		<AssemblyName>GrpCurl.Net.Core</AssemblyName>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
		<PackageId>GrpCurl.Net.Core</PackageId>
		<Description>Reusable core library for GrpCurl.Net — descriptor sources, channel factory, dynamic invocation, protoset I/O. Backs both the GrpCurl.Net CLI and the Gql2Grpc proxy.</Description>
		<PackageTags>grpc;protobuf;reflection;cli;grpcurl</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" />
		<PackageReference Include="Google.Api.CommonProtos" />
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Grpc.Tools">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Spectre.Console" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos/reflection.proto" GrpcServices="Client" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GrpCurl.Net" />
		<InternalsVisibleTo Include="GrpCurl.Net.Tests.Unit" />
		<InternalsVisibleTo Include="GrpCurl.Net.Tests.Integration" />
		<InternalsVisibleTo Include="Gql2Grpc" />
		<InternalsVisibleTo Include="Gql2Grpc.Tests" />
	</ItemGroup>

</Project>
