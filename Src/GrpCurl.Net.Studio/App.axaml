<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrpCurl.Net.Studio"
             x:Class="GrpCurl.Net.Studio.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GrpCurl.Net.Studio/Themes/SemanticTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Editor defaults (FR-152); EditorOptionsManager overrides these from settings, live. -->
            <FontFamily x:Key="Editor.FontFamily">Cascadia Code,Consolas,monospace</FontFamily>
            <x:Double x:Key="Editor.FontSize">13</x:Double>
            <x:Int32 x:Key="Editor.IndentationSize">2</x:Int32>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Code editor styling for request/response payloads (ADR-004). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- SPEC-020 §6: consistent accent keyboard-focus outline (after Fluent so it wins). -->
        <StyleInclude Source="avares://GrpCurl.Net.Studio/Themes/FocusStyles.axaml" />
    </Application.Styles>

</Application>
