<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GrpCurl.Net.Studio</RootNamespace>
        <AssemblyName>GrpCurl.Net.Studio</AssemblyName>
        <IsPackable>false</IsPackable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Compiled bindings turn loose XAML bindings into build errors (fixed immediately)
             rather than runtime warnings, which keeps TreatWarningsAsErrors honest. -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <!-- Dev-tools only: assets excluded outside Debug so they never ship in Release/CI. -->
        <PackageReference Include="Avalonia.Diagnostics">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <!-- Windows DPAPI secret backend (SEC-017); no-op reference on Linux/macOS. -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />

        <!-- Code editor for request/response payloads (ADR-004). -->
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GrpCurl.Net.Studio.ViewModels\GrpCurl.Net.Studio.ViewModels.csproj" />
        <ProjectReference Include="..\GrpCurl.Net.Core\GrpCurl.Net.Core.csproj" />
        <!-- P4: Studio drives the Gql2Grpc bridge in-process (GQL-007 one-engine) via GraphQlService. -->
        <ProjectReference Include="..\Gql2Grpc\Gql2Grpc.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GrpCurl.Net.Studio.Tests.Unit" />
        <InternalsVisibleTo Include="GrpCurl.Net.Studio.Tests.UI" />
        <InternalsVisibleTo Include="GrpCurl.Net.Studio.Tests.Perf" />
    </ItemGroup>

    <ItemGroup>
        <!-- P4 (GQL-010): TextMateSharp.Grammars has no GraphQL grammar, so the document editor's
             source.graphql scope is served from this vendored grammar via GraphQlRegistryOptions. -->
        <EmbeddedResource Include="Assets\Grammars\graphql.tmLanguage.json" />
    </ItemGroup>

</Project>
