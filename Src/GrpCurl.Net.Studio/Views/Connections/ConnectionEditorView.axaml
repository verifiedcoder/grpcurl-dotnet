<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GrpCurl.Net.Studio.ViewModels.Connections;assembly=GrpCurl.Net.Studio.ViewModels"
             x:Class="GrpCurl.Net.Studio.Views.Connections.ConnectionEditorView"
             x:DataType="vm:ConnectionEditorViewModel"
             Width="460">
    <UserControl.Resources>
        <!-- One ordered descriptor-path row: path + size/warning, with reorder + remove. Keyed (not
             implicit) so it can be shared by the protoset / proto / import-path lists. -->
        <DataTemplate x:Key="DescriptorRowTemplate" x:DataType="vm:DescriptorPathRow">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SizeText}" FontSize="11" IsVisible="{Binding HasSize}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Text="{Binding Warning}" FontSize="11" IsVisible="{Binding HasWarning}"
                               Foreground="{DynamicResource Status.Server}" />
                </StackPanel>
                <Button Grid.Column="1" Content="↑" Margin="4,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:ConnectionEditorViewModel)DataContext).MoveDescriptorRowUpCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                <Button Grid.Column="2" Content="↓" Margin="4,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:ConnectionEditorViewModel)DataContext).MoveDescriptorRowDownCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                <Button Grid.Column="3" Content="✕" Margin="4,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:ConnectionEditorViewModel)DataContext).RemoveDescriptorRowCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Remove path" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer MaxHeight="620">
        <StackPanel Margin="20" Spacing="12">

            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name}" Watermark="My server"
                         AutomationProperties.Name="Connection name" />
                <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource Status.Server}" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Address" />
                <TextBox Text="{Binding Address}" Watermark="host:port or [::1]:port or unix:///path"
                         AutomationProperties.Name="Server address" />
                <TextBlock Text="{Binding AddressError}" Foreground="{DynamicResource Status.Server}" FontSize="12" />
            </StackPanel>

            <CheckBox IsChecked="{Binding IsPlaintext}" Content="Use plaintext (no TLS)"
                      AutomationProperties.Name="Use plaintext" />

            <Grid ColumnDefinitions="*,*,*" >
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                    <TextBlock Text="Connect timeout" />
                    <TextBox Text="{Binding ConnectTimeout}" Watermark="10s"
                             AutomationProperties.Name="Connect timeout" />
                    <TextBlock Text="{Binding ConnectTimeoutError}" Foreground="{DynamicResource Status.Server}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Margin="3,0">
                    <TextBlock Text="Keepalive time" />
                    <TextBox Text="{Binding KeepaliveTime}" Watermark="60s"
                             AutomationProperties.Name="Keepalive time" />
                    <TextBlock Text="{Binding KeepaliveTimeError}" Foreground="{DynamicResource Status.Server}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
                    <TextBlock Text="Keepalive timeout" />
                    <TextBox Text="{Binding KeepaliveTimeout}" Watermark="30s"
                             AutomationProperties.Name="Keepalive timeout" />
                    <TextBlock Text="{Binding KeepaliveTimeoutError}" Foreground="{DynamicResource Status.Server}" FontSize="12" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                    <TextBlock Text="Authority override" />
                    <TextBox Text="{Binding Authority}" AutomationProperties.Name="Authority override" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                    <TextBlock Text="TLS server name (SNI)" />
                    <TextBox Text="{Binding ServerName}" IsEnabled="{Binding !IsPlaintext}"
                             AutomationProperties.Name="TLS server name" />
                </StackPanel>
            </Grid>

            <!-- TLS profile (FR-012/FR-030) — applies only under TLS -->
            <StackPanel Spacing="4" IsEnabled="{Binding IsTlsProfileEnabled}">
                <TextBlock Text="TLS profile" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding TlsProfiles}" SelectedItem="{Binding SelectedTlsProfile}"
                              DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="TLS profile" />
                    <Button Grid.Column="1" Content="New…" Margin="6,0,0,0" Command="{Binding NewProfileCommand}"
                            IsVisible="{Binding CanManageProfiles}" AutomationProperties.Name="New TLS profile" />
                    <Button Grid.Column="2" Content="Edit…" Margin="6,0,0,0" Command="{Binding EditProfileCommand}"
                            IsVisible="{Binding CanManageProfiles}" AutomationProperties.Name="Edit TLS profile" />
                    <Button Grid.Column="3" Content="Manage…" Margin="6,0,0,0" Command="{Binding ManageProfilesCommand}"
                            IsVisible="{Binding CanManageProfiles}" AutomationProperties.Name="Manage TLS profiles" />
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="System default validates against OS roots. Custom CA / mTLS / skip-verify live in a profile." />
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           IsVisible="{Binding IsUnixSocket}"
                           Text="TLS is not used for Unix domain sockets." />
            </StackPanel>

            <!-- Descriptor source (FR-040..047) -->
            <StackPanel Spacing="6">
                <TextBlock Text="Descriptor source" />
                <ComboBox ItemsSource="{Binding DescriptorModes}" SelectedItem="{Binding SelectedDescriptorMode}"
                          MinWidth="200" HorizontalAlignment="Left" AutomationProperties.Name="Descriptor source mode" />
                <TextBlock Text="{Binding EffectiveSourceText}" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />

                <!-- Protoset files -->
                <StackPanel Spacing="4" IsVisible="{Binding IsProtosetMode}">
                    <Button Content="Add protoset(s)…" Command="{Binding AddProtosetsCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding CanPickFiles}" AutomationProperties.Name="Add protosets" />
                    <ItemsControl ItemsSource="{Binding ProtosetRows}" ItemTemplate="{StaticResource DescriptorRowTemplate}" />
                </StackPanel>

                <!-- Proto files + import paths -->
                <StackPanel Spacing="4" IsVisible="{Binding IsProtoMode}">
                    <Border IsVisible="{Binding ShowProtocRemediation}" Background="{DynamicResource Banner.DangerBg}"
                            CornerRadius="4" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Foreground="{DynamicResource Status.Server}" TextWrapping="Wrap"
                                       Text="protoc was not found. Set a protoc path in Settings → protoc, or use a protoset instead." />
                            <TextBlock Text="{Binding ProtocStatus}" FontSize="11" TextWrapping="Wrap" />
                            <Button Content="Use a protoset instead" Command="{Binding SwitchToProtosetCommand}"
                                    HorizontalAlignment="Left" AutomationProperties.Name="Switch to protoset" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text=".proto files" FontSize="12" />
                    <Button Content="Add .proto file(s)…" Command="{Binding AddProtoFilesCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding CanPickFiles}" AutomationProperties.Name="Add proto files" />
                    <ItemsControl ItemsSource="{Binding ProtoFileRows}" ItemTemplate="{StaticResource DescriptorRowTemplate}" />

                    <TextBlock Text="Import directories (-I)" FontSize="12" Margin="0,6,0,0" />
                    <Button Content="Add import directory…" Command="{Binding AddImportPathCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding CanPickFiles}" AutomationProperties.Name="Add import directory" />
                    <ItemsControl ItemsSource="{Binding ImportPathRows}" ItemTemplate="{StaticResource DescriptorRowTemplate}" />
                </StackPanel>

                <!-- Limits (FR-047) -->
                <Expander Header="Limits">
                    <ItemsControl ItemsSource="{Binding DescriptorLimits}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="User-Agent" />
                <TextBox Text="{Binding UserAgent}" AutomationProperties.Name="User agent" />
            </StackPanel>

            <!-- Reflection-only headers (FR-017) -->
            <StackPanel Spacing="4">
                <DockPanel>
                    <TextBlock Text="Reflection headers" VerticalAlignment="Center" />
                    <Button Content="Add" Command="{Binding AddHeaderCommand}" HorizontalAlignment="Right"
                            DockPanel.Dock="Right" AutomationProperties.Name="Add reflection header" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ReflectionHeaders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeaderRowViewModel">
                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                                <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="name" Margin="0,0,4,0"
                                         AutomationProperties.Name="Header name" />
                                <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="value" Margin="4,0"
                                         AutomationProperties.Name="Header value" />
                                <Button Grid.Column="2" Content="✕" Margin="4,0,0,0"
                                        Command="{Binding $parent[ItemsControl].((vm:ConnectionEditorViewModel)DataContext).RemoveHeaderCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Remove header" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Test connection -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                            AutomationProperties.Name="Test connection" />
                    <Button Content="Cancel test" Command="{Binding TestConnectionCancelCommand}"
                            IsVisible="{Binding IsTesting}" AutomationProperties.Name="Cancel test" />
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsTesting}"
                                 VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding LastTestResult.Message}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Save / Cancel -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80"
                        AutomationProperties.Name="Cancel" />
                <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="80" IsDefault="True"
                        AutomationProperties.Name="Save connection" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
