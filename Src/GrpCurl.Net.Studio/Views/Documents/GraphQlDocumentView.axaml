<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:docs="clr-namespace:GrpCurl.Net.Studio.ViewModels.Documents;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:conn="clr-namespace:GrpCurl.Net.Studio.ViewModels.Connections;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:gql="clr-namespace:GrpCurl.Net.Studio.ViewModels.Models.GraphQl;assembly=GrpCurl.Net.Studio.ViewModels"
             x:Class="GrpCurl.Net.Studio.Views.Documents.GraphQlDocumentView"
             x:Name="Root"
             x:DataType="docs:GraphQlDocumentViewModel">

    <UserControl.KeyBindings>
        <!-- GQL-021: Execute on Ctrl+Enter, same chord as invocation tabs. -->
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ExecuteCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <!-- Request-header editor row (GQL-003): name/value + -bin validity. -->
        <DataTemplate x:Key="GraphQlHeaderRowTemplate" x:DataType="conn:HeaderRowViewModel">
            <StackPanel Margin="0,2" Spacing="1">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="name"
                             AutomationProperties.Name="Header name" />
                    <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="value"
                             AutomationProperties.Name="Header value" />
                    <Button Grid.Column="2" Content="✕" Padding="6,0"
                            Command="{Binding #Root.((docs:GraphQlDocumentViewModel)DataContext).RemoveHeaderCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Remove header" />
                </Grid>
                <TextBlock Text="{Binding BinError}" FontSize="11" IsVisible="{Binding HasBinError}"
                           Foreground="{DynamicResource Status.Server}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">

        <!-- ── Header bar: connection · operation picker · default service · Execute/Cancel · status ── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                       Text="{Binding Connection.Address}" ToolTip.Tip="Target connection" />

            <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding Operations}"
                      SelectedItem="{Binding SelectedOperation}"
                      AutomationProperties.Name="Operation"
                      ToolTip.Tip="Operation to execute (GQL-012)">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="gql:GraphQlOperationInfo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource Status.Neutral}" CornerRadius="3" Padding="4,0">
                                <TextBlock Text="{Binding Kind}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="2" Text="{Binding DefaultService}" Watermark="default service (e.g. pkg.Service)"
                     AutomationProperties.Name="Default service"
                     ToolTip.Tip="Fully-qualified gRPC service used by convention fallback (--default-service)" />

            <Button Grid.Column="3" Content="Execute" Command="{Binding ExecuteCommand}"
                    IsVisible="{Binding !IsInFlight}" Classes="accent"
                    AutomationProperties.Name="Execute" />
            <Button Grid.Column="3" Content="Cancel" Command="{Binding ExecuteCancelCommand}"
                    IsVisible="{Binding IsInFlight}"
                    AutomationProperties.Name="Cancel" />

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding StatusText}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Status.Neutral}" />
        </Grid>

        <!-- ── Editors: document + variables (left) · response (right) ── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,*">

            <Grid Grid.Column="0" RowDefinitions="Auto,2*,Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                    <TextBlock Text="Document" VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="0,0,4,0" />
                    <Button Content="Open…" Command="{Binding OpenDocumentCommand}" Padding="6,0"
                            AutomationProperties.Name="Open GraphQL document" />
                    <Button Content="Save…" Command="{Binding SaveDocumentCommand}" Padding="6,0"
                            AutomationProperties.Name="Save GraphQL document" />
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Status.Neutral}" BorderThickness="1" CornerRadius="3">
                    <ae:TextEditor x:Name="DocumentEditor" ShowLineNumbers="True"
                                   FontFamily="{DynamicResource Editor.FontFamily}"
                                   FontSize="{DynamicResource Editor.FontSize}"
                                   AutomationProperties.Name="GraphQL document" />
                </Border>

                <StackPanel Grid.Row="2" Spacing="4" Margin="0,6,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Variables (JSON)" VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="0,0,4,0" />
                        <Button Content="Import…" Command="{Binding ImportVariablesCommand}" Padding="6,0"
                                AutomationProperties.Name="Import variables" />
                    </StackPanel>

                    <!-- GQL-018: quick-vars grid — a scalar projection of the variables JSON for the declared variables. -->
                    <ItemsControl ItemsSource="{Binding VariableRows}" IsVisible="{Binding HasVariableRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="docs:GraphQlVariableRow">
                                <Grid ColumnDefinitions="*,Auto,2*" ColumnSpacing="6" Margin="0,1">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                        <Run Text="$" /><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="{Binding RequiredMarker}" Foreground="{DynamicResource Status.Server}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                                    <TextBox Grid.Column="2" Text="{Binding Value}" Watermark="value" FontSize="12"
                                             AutomationProperties.Name="Variable value" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- GQL-019: unbound-required / undeclared-bound warnings. -->
                    <ItemsControl ItemsSource="{Binding VariableWarnings}" IsVisible="{Binding HasVariableWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gql:GraphQlProblem">
                                <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Status.Server}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="3" BorderBrush="{DynamicResource Status.Neutral}" BorderThickness="1" CornerRadius="3">
                    <ae:TextEditor x:Name="VariablesEditor"
                                   FontFamily="{DynamicResource Editor.FontFamily}"
                                   FontSize="{DynamicResource Editor.FontSize}"
                                   AutomationProperties.Name="Variables JSON" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <Grid Grid.Column="2">
                <!-- Query/mutation: the single response envelope. -->
                <Border IsVisible="{Binding !IsSubscription}"
                        BorderBrush="{DynamicResource Status.Neutral}" BorderThickness="1" CornerRadius="3">
                    <ae:TextEditor x:Name="ResponseEditor" IsReadOnly="True"
                                   FontFamily="{DynamicResource Editor.FontFamily}"
                                   FontSize="{DynamicResource Editor.FontSize}"
                                   AutomationProperties.Name="Response envelope" />
                </Border>

                <!-- Subscription: the streaming console (GQL-060..065). -->
                <Grid IsVisible="{Binding IsSubscription}" RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <TextBlock Text="Subscription" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Export NDJSON" Command="{Binding ExportStreamCommand}" Padding="6,0"
                                AutomationProperties.Name="Export subscription stream" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource Status.Neutral}" BorderThickness="1" CornerRadius="3">
                        <ListBox ItemsSource="{Binding StreamLog.Rows}" AutomationProperties.Name="Subscription envelopes">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="docs:GraphQlStreamRow">
                                    <StackPanel Margin="0,1">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                            <ToggleButton Grid.Column="0" Content="⋯" Padding="4,0" Background="Transparent" BorderThickness="0"
                                                          IsChecked="{Binding IsExpanded}" IsVisible="{Binding !IsStatus}"
                                                          AutomationProperties.Name="Expand envelope" />
                                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Index}" Opacity="0.5"
                                                       IsVisible="{Binding !IsStatus}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Preview}" FontFamily="Cascadia Code,Consolas,monospace"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsExpanded}" />
                                        </Grid>
                                        <TextBox Text="{Binding Json}" IsReadOnly="True" IsVisible="{Binding IsExpanded}"
                                                 FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"
                                                 TextWrapping="Wrap" Background="Transparent" BorderThickness="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- GQL-065 stats line + truncation notice (no silent caps). -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="2,4,0,0">
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="{Binding StreamLog.TotalReceived}" /><Run Text=" msgs · " /><Run Text="{Binding StreamLog.ElapsedText}" /><Run Text=" · " /><Run Text="{Binding StreamLog.RateText}" />
                        </TextBlock>
                        <TextBlock Text="{Binding StreamLog.TruncationNotice}" FontSize="11"
                                   Foreground="{DynamicResource Status.Neutral}" IsVisible="{Binding StreamLog.IsTruncated}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Footer: output options · headers · Problems strip ── -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
            <WrapPanel>
                <CheckBox Content="emit-defaults" IsChecked="{Binding EmitDefaults}" Margin="0,0,12,0" />
                <CheckBox Content="allow-unknown-fields" IsChecked="{Binding AllowUnknownFields}" Margin="0,0,12,0" />
                <CheckBox Content="strict-selection" IsChecked="{Binding StrictSelection}" Margin="0,0,12,0" />
                <CheckBox Content="introspection" IsChecked="{Binding Introspection}" Margin="0,0,12,0" />
                <CheckBox Content="raw" IsChecked="{Binding Raw}" Margin="0,0,12,0"
                          ToolTip.Tip="Show the unprojected gRPC JSON (no GraphQL projection) — parity with CLI --raw" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Verbose" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    <ComboBox MinWidth="110" ItemsSource="{Binding Verbosities}" SelectedItem="{Binding Verbosity}"
                              AutomationProperties.Name="Verbose level"
                              ToolTip.Tip="Show per-field resolved mapping (-v) and request JSON (-vv)" />
                </StackPanel>
                <Button Content="Copy response" Command="{Binding CopyResponseCommand}" Padding="6,0" Margin="0,0,4,0" />
                <Button Content="Copy as CLI" Command="{Binding CopyAsCliCommand}" Padding="6,0" Margin="0,0,4,0"
                        ToolTip.Tip="Copy the equivalent gql2grpc command (secrets as ${VAR})" />
                <Button Content="Schema" Command="{Binding LoadSchemaCommand}" Padding="6,0"
                        ToolTip.Tip="Derive the GraphQL schema locally from the descriptors (no RPC)" />
            </WrapPanel>

            <!-- GQL-025: a cancelled run keeps whatever was assembled, with a clear banner. -->
            <Border IsVisible="{Binding IsCancelled}" Background="{DynamicResource Status.Neutral}"
                    CornerRadius="3" Padding="6,2">
                <TextBlock Text="Cancelled." FontSize="12" />
            </Border>

            <!-- GQL-024 / AC-6: per-root-field parallel progress (queued → in-flight → done/failed + elapsed). -->
            <ItemsControl ItemsSource="{Binding FieldProgress}" IsVisible="{Binding HasFieldProgress}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="docs:GraphQlFieldProgressRow">
                        <Border BorderBrush="{DynamicResource Status.Neutral}" BorderThickness="1" CornerRadius="3"
                                Padding="6,1" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Glyph}" />
                                <TextBlock Text="{Binding ResponseKey}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ElapsedText}" Opacity="0.6"
                                           IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- GQL-040..043: live resolution preview — per-root-field target, source, kind; unresolvable flagged. -->
            <Expander Header="Resolution" IsVisible="{Binding HasResolutions}" IsExpanded="True">
                <StackPanel Spacing="2">
                    <TextBlock FontSize="11" Opacity="0.7" IsVisible="{Binding HasDefaultServiceOverride}">
                        <Run Text="Tab default-service overrides the mapping's defaults.service → " /><Run Text="{Binding DefaultServiceOverride}" FontWeight="SemiBold" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Resolutions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gql:GraphQlFieldResolution">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Status.Neutral}" Padding="0,3">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" VerticalAlignment="Center">
                                                <Run Text="{Binding FieldName}" FontWeight="SemiBold" /><Run Text=" → " /><Run Text="{Binding Target}" />
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,0" Background="{DynamicResource Status.Neutral}"
                                                    IsVisible="{Binding Resolved}">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" />
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Opacity="0.7"
                                                       Text="explicit" IsVisible="{Binding IsExplicit}" />
                                        </Grid>
                                        <!-- GQL-040: convention derivation. -->
                                        <TextBlock Text="{Binding Derivation}" FontSize="11" Opacity="0.6"
                                                   IsVisible="{Binding HasDerivation}" />
                                        <!-- GQL-042: unresolvable field remedy (config error, before execution). -->
                                        <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Status.Server}" IsVisible="{Binding IsUnresolved}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- GQL-070/073: structured errors[] — upstream gRPC failures visually distinct from config/usage errors. -->
            <ItemsControl ItemsSource="{Binding Errors}" IsVisible="{Binding HasErrors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gql:GraphQlErrorInfo">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Status.Neutral}" Padding="0,3">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border CornerRadius="3" Padding="4,0" Background="{DynamicResource Status.Server}" IsVisible="{Binding IsUpstream}">
                                        <TextBlock Text="upstream" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border CornerRadius="3" Padding="4,0" Background="{DynamicResource Status.Neutral}" IsVisible="{Binding !IsUpstream}">
                                        <TextBlock Text="config" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- GQL-070: the error path as a breadcrumb. -->
                                <TextBlock FontSize="11" Opacity="0.7" IsVisible="{Binding HasPath}">
                                    <Run Text="at " /><Run Text="{Binding PathText}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ExtensionsText}" FontSize="11" Opacity="0.6"
                                           IsVisible="{Binding ExtensionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- GQL-075/076/078: derived schema viewer — local introspection (no RPC), type tree + copy JSON. -->
            <Expander IsVisible="{Binding HasSchema}" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Schema: " /><Run Text="{Binding SchemaName}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Button Content="Copy JSON" Command="{Binding CopySchemaJsonCommand}" Padding="6,0"
                                AutomationProperties.Name="Copy introspection JSON" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static docs:GraphQlDocumentViewModel.SchemaLimitationNote}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SchemaTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gql:GraphQlSchemaType">
                                <Expander Padding="0" Margin="0,1">
                                    <Expander.Header>
                                        <TextBlock FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=" : " /><Run Text="{Binding Kind}" Foreground="{DynamicResource Status.Neutral}" />
                                        </TextBlock>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Members}" Margin="16,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gql:GraphQlSchemaMember">
                                                <TextBlock FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                                    <Run Text="{Binding Name}" /><Run Text="{Binding TypeName, StringFormat=' : {0}'}" Foreground="{DynamicResource Status.Neutral}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- GQL-029: verbose pane — per-field resolved mapping (-v) + request JSON (-vv), captured from the engine. -->
            <Expander Header="Verbose" IsVisible="{Binding HasVerboseLog}" IsExpanded="True">
                <ItemsControl ItemsSource="{Binding VerboseLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                       TextWrapping="Wrap" Opacity="0.8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Expander Header="Headers">
                <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{Binding Headers}" ItemTemplate="{StaticResource GraphQlHeaderRowTemplate}" />
                    <Button Content="+ Add header" Command="{Binding AddHeaderCommand}" HorizontalAlignment="Left" Padding="6,0" />
                </StackPanel>
            </Expander>

            <!-- Problems strip (GQL-011 syntax + AC-5 variable/config errors). -->
            <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gql:GraphQlProblem">
                        <TextBlock Margin="0,1" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Status.Server}">
                            <Run Text="{Binding Kind}" FontWeight="SemiBold" />
                            <Run Text=" — " />
                            <Run Text="{Binding Message}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
