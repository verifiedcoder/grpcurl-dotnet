<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:docs="clr-namespace:GrpCurl.Net.Studio.ViewModels.Documents;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:conn="clr-namespace:GrpCurl.Net.Studio.ViewModels.Connections;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:inv="clr-namespace:GrpCurl.Net.Studio.ViewModels.Models.Invocation;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:conv="clr-namespace:GrpCurl.Net.Studio.Converters"
             x:Class="GrpCurl.Net.Studio.Views.Documents.InvocationDocumentView"
             x:Name="Root"
             x:DataType="docs:InvocationDocumentViewModel">

    <UserControl.Resources>
        <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
        <conv:SecretMaskConverter x:Key="SecretMask" />
    </UserControl.Resources>

    <!-- Rich google.rpc.Status detail panels (implicit templates, resolved by data type). -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="inv:BadRequestDetail">
            <ItemsControl ItemsSource="{Binding Violations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inv:FieldViolation">
                        <TextBlock Margin="0,1" TextWrapping="Wrap" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                            <Run Text="{Binding Field}" FontWeight="SemiBold" />
                            <Run Text=" — " />
                            <Run Text="{Binding Description}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="inv:RetryInfoDetail">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Server suggests retrying after" />
                    <Run Text="{Binding Delay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Content="Retry"
                        Command="{Binding $parent[UserControl].((docs:InvocationDocumentViewModel)DataContext).RetryCommand}"
                        AutomationProperties.Name="Retry after delay" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="inv:ErrorInfoDetail">
            <StackPanel Spacing="2">
                <TextBlock>
                    <Run Text="Reason:" FontWeight="SemiBold" />
                    <Run Text="{Binding Reason}" />
                    <Run Text="  Domain:" FontWeight="SemiBold" />
                    <Run Text="{Binding Domain}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Metadata}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="inv:MetadataItem">
                            <TextBlock Margin="0,1" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                <Run Text=" = " />
                                <Run Text="{Binding Value}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="inv:QuotaFailureDetail">
            <ItemsControl ItemsSource="{Binding Violations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inv:QuotaViolation">
                        <TextBlock Margin="0,1" TextWrapping="Wrap">
                            <Run Text="{Binding Subject}" FontWeight="SemiBold" />
                            <Run Text=" — " />
                            <Run Text="{Binding Description}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="inv:PreconditionFailureDetail">
            <ItemsControl ItemsSource="{Binding Violations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inv:PreconditionViolation">
                        <TextBlock Margin="0,1" TextWrapping="Wrap">
                            <Run Text="{Binding Type}" FontWeight="SemiBold" />
                            <Run Text=" / " />
                            <Run Text="{Binding Subject}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Description}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="inv:HelpDetail">
            <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inv:HelpLink">
                        <Button Margin="0,1" Padding="0" Background="Transparent" BorderThickness="0"
                                Content="{Binding Description}"
                                Command="{Binding $parent[UserControl].((docs:InvocationDocumentViewModel)DataContext).OpenHelpLinkCommand}"
                                CommandParameter="{Binding Url}"
                                Foreground="{DynamicResource Status.Neutral}"
                                AutomationProperties.Name="Open help link" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="inv:LocalizedMessageDetail">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Locale}" FontWeight="SemiBold" Foreground="{DynamicResource Status.Neutral}" />
                <Run Text="  " />
                <Run Text="{Binding Message}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="inv:GenericDetail">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding TypeUrl}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Json}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*,4,*">

        <!-- Header: method + connection + Invoke/Cancel -->
        <Border Grid.Row="0" Background="{DynamicResource Surface.PaneHeader}" Padding="10,6"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Content="Copy as CLI" Command="{Binding CopyAsCliCommand}"
                            ToolTip.Tip="Copy an equivalent grpcn command (secrets as ${VAR})"
                            AutomationProperties.Name="Copy as CLI command" />
                    <Button Content="Invoke" Command="{Binding InvokeCommand}"
                            IsVisible="{Binding !IsInFlight}" AutomationProperties.Name="Invoke" />
                    <Button Content="Cancel" Command="{Binding InvokeCancelCommand}"
                            IsVisible="{Binding IsInFlight}" AutomationProperties.Name="Cancel invoke" />
                    <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"
                                 IsVisible="{Binding IsInFlight}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding MethodSymbol}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Connection.Address}" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Options bar -->
        <Border Grid.Row="1" Padding="10,6" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Deadline" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding Deadline}" Watermark="e.g. 10s" Width="90" Margin="0,0,16,0"
                         AutomationProperties.Name="Deadline" />
                <TextBlock Text="Max msg size" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding MaxMessageSize}" Watermark="e.g. 4MB" Width="90" Margin="0,0,16,0"
                         AutomationProperties.Name="Max message size" />
                <CheckBox Content="Emit defaults" IsChecked="{Binding EmitDefaults}" Margin="0,0,12,0" />
                <CheckBox Content="Allow unknown fields" IsChecked="{Binding AllowUnknownFields}" />
            </WrapPanel>
        </Border>

        <!-- Request: headers + JSON editor + advisory problems strip -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
            <Expander Grid.Row="0" Header="Request headers" Margin="8,6,8,0">
                <StackPanel Spacing="4" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding Headers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="conn:HeaderRowViewModel">
                                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2" ColumnSpacing="4">
                                    <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="name"
                                             AutomationProperties.Name="Header name" />
                                    <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="value"
                                             PasswordChar="{Binding IsSecret, Converter={StaticResource SecretMask}}"
                                             AutomationProperties.Name="Header value" />
                                    <Button Grid.Column="2" Content="✕" Padding="6,0"
                                            Command="{Binding #Root.((docs:InvocationDocumentViewModel)DataContext).RemoveHeaderCommand}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Remove header" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add header" HorizontalAlignment="Left" Command="{Binding AddHeaderCommand}"
                            AutomationProperties.Name="Add header" />
                </StackPanel>
            </Expander>

            <Border Grid.Row="1" Margin="8,6" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3">
                <ae:TextEditor x:Name="RequestEditor" ShowLineNumbers="True"
                               FontFamily="Cascadia Code,Consolas,monospace" FontSize="13"
                               AutomationProperties.Name="Request body" />
            </Border>

            <!-- FR-063: advisory validation problems (Invoke is never blocked). -->
            <Border Grid.Row="2" IsVisible="{Binding HasProblems}" Margin="8,0,8,6" Padding="6,4"
                    Background="{DynamicResource Surface.PaneHeader}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3">
                <ItemsControl ItemsSource="{Binding Problems}" AutomationProperties.Name="Request problems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="inv:ValidationProblem">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                <TextBlock Text="⚠" FontSize="12" Foreground="{DynamicResource Status.Server}" />
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Status.Server}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Divider}" />

        <!-- Response -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Padding="10,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                            IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   AutomationProperties.Name="Status" />
                    </Border>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Copy"
                            Command="{Binding CopyResponseCommand}" AutomationProperties.Name="Copy response" />
                    <TextBlock Text="Response" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                </DockPanel>
            </Border>

            <!-- Rich error panel (FR-090..099) — inline only, shown on failure. -->
            <Border Grid.Row="1" IsVisible="{Binding HasError}" Margin="8,0,8,8" Padding="10"
                    Background="{DynamicResource Surface.PaneHeader}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3">
                <StackPanel Spacing="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                            <Button Content="Retry" Command="{Binding RetryCommand}" AutomationProperties.Name="Retry invoke" />
                            <Button Content="Copy as JSON" Command="{Binding CopyErrorJsonCommand}"
                                    AutomationProperties.Name="Copy error as JSON" />
                        </StackPanel>
                        <TextBlock Text="{Binding Error.Headline}" FontWeight="SemiBold" FontSize="14"
                                   TextWrapping="Wrap" AutomationProperties.Name="Error headline" />
                    </DockPanel>

                    <TextBlock Opacity="0.7" FontSize="12">
                        <Run Text="calling" />
                        <Run Text="{Binding Error.Method}" FontWeight="SemiBold" />
                        <Run Text="on" />
                        <Run Text="{Binding Error.Address}" FontWeight="SemiBold" />
                    </TextBlock>

                    <TextBlock Text="{Binding Error.Hint}" FontStyle="Italic" TextWrapping="Wrap"
                               IsVisible="{Binding Error.Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <StackPanel Spacing="2" IsVisible="{Binding HasErrorSuggestions}">
                        <TextBlock Text="Try:" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Error.Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="inv:SuggestionModel">
                                    <TextBlock Margin="8,0,0,0" TextWrapping="Wrap">
                                        <Run Text="•" />
                                        <Run Text="{Binding Text}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Error.Details}" IsVisible="{Binding HasErrorDetails}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inv:ErrorDetailModel">
                                <Border Margin="0,3,0,0" Padding="8" CornerRadius="3"
                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource Status.Neutral}" />
                                        <ContentControl Content="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="2" Margin="8,0,8,8">
                <TabItem Header="Body">
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor x:Name="ResponseEditor" ShowLineNumbers="True" IsReadOnly="True"
                                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="13"
                                       AutomationProperties.Name="Response body" />
                    </Border>
                </TabItem>
                <TabItem Header="Headers">
                    <ItemsControl ItemsSource="{Binding ResponseHeaders}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inv:MetadataItem">
                                <TextBlock Margin="0,1" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Value}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
                <TabItem Header="Trailers">
                    <ItemsControl ItemsSource="{Binding ResponseTrailers}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inv:MetadataItem">
                                <TextBlock Margin="0,1" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Value}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
                <TabItem Header="Timing">
                    <ItemsControl ItemsSource="{Binding Timing}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inv:TimingPhase">
                                <TextBlock Margin="0,1">
                                    <Run Text="{Binding Phase}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Duration}" Foreground="{DynamicResource Status.Neutral}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
