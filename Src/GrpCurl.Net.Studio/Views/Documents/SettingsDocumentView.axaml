<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:GrpCurl.Net.Studio.ViewModels.Documents;assembly=GrpCurl.Net.Studio.ViewModels"
             x:Class="GrpCurl.Net.Studio.Views.Documents.SettingsDocumentView"
             x:Name="Root"
             x:DataType="docs:SettingsDocumentViewModel">

    <UserControl.Styles>
        <!-- One settings row: label + control + inline description + reset. -->
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.settingHint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="20,14">
        <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Settings" FontWeight="Bold" FontSize="20" />
            <TextBlock Classes="settingHint"
                       Text="Changes apply and save immediately. Each setting can be reset to its default." />

            <!-- ───────── General ───────── -->
            <TextBlock Classes="sectionHeader" Text="General" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Theme" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="theme"
                            AutomationProperties.Name="Reset theme" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Theme" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Light, Dark, or follow the OS (default: System). Applies live." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Startup" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="startup"
                            AutomationProperties.Name="Reset startup" />
                    <ComboBox ItemsSource="{Binding StartupOptions}" SelectedItem="{Binding Startup}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Startup behaviour" />
                </DockPanel>
                <TextBlock Classes="settingHint"
                           Text="Reopen the last workspace and tabs, or start empty (default: Restore last workspace)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="CLI export dialect" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="dialect"
                            AutomationProperties.Name="Reset CLI dialect" />
                    <ComboBox ItemsSource="{Binding DialectOptions}" SelectedItem="{Binding CliShellDialect}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="CLI export dialect" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default shell quoting for &quot;Copy as CLI&quot; (default: Bash)." />
            </StackPanel>

            <!-- ───────── Editor ───────── -->
            <TextBlock Classes="sectionHeader" Text="Editor" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Font family" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="fontFamily"
                            AutomationProperties.Name="Reset font family" />
                    <TextBox Text="{Binding EditorFontFamily}" MinWidth="260" HorizontalAlignment="Left"
                             AutomationProperties.Name="Editor font family" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Applies to all code editors (default: Cascadia Code,Consolas,monospace)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Font size" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="fontSize"
                            AutomationProperties.Name="Reset font size" />
                    <NumericUpDown Value="{Binding EditorFontSize}" Minimum="8" Maximum="32" Increment="1"
                                   MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Editor font size" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Editor text size in points (default: 13)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Indentation width" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="indent"
                            AutomationProperties.Name="Reset indentation width" />
                    <NumericUpDown Value="{Binding EditorIndentWidth}" Minimum="1" Maximum="8" Increment="1"
                                   MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Indentation width" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Spaces per indent for pretty-printed JSON (default: 2)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding EditorFormatOnPaste}" Content="Format on paste"
                          AutomationProperties.Name="Format on paste" />
                <TextBlock Classes="settingHint" Text="Re-indent pasted JSON (default: on)." />
            </StackPanel>

            <!-- ───────── Network defaults ───────── -->
            <TextBlock Classes="sectionHeader" Text="Network defaults" />
            <TextBlock Classes="settingHint"
                       Text="Applied to new connections and invocation tabs as initial values; existing ones are never changed." />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Connect timeout" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="connectTimeout"
                            AutomationProperties.Name="Reset connect timeout" />
                    <TextBox Text="{Binding NetworkConnectTimeout}" Watermark="e.g. 10s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Connect timeout" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Duration grammar (500ms, 10s, 1.5m). Default: 10s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Keepalive time" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="keepaliveTime"
                            AutomationProperties.Name="Reset keepalive time" />
                    <TextBox Text="{Binding NetworkKeepaliveTime}" Watermark="e.g. 60s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Keepalive time" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default: 60s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Keepalive timeout" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="keepaliveTimeout"
                            AutomationProperties.Name="Reset keepalive timeout" />
                    <TextBox Text="{Binding NetworkKeepaliveTimeout}" Watermark="e.g. 30s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Keepalive timeout" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default: 30s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Max message size" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="maxMessageSize"
                            AutomationProperties.Name="Reset max message size" />
                    <TextBox Text="{Binding NetworkMaxMessageSize}" Watermark="e.g. 4MB (empty = client default)"
                             MinWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Max message size" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Empty uses the gRPC client default." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Default deadline" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="defaultDeadline"
                            AutomationProperties.Name="Reset default deadline" />
                    <TextBox Text="{Binding NetworkDefaultDeadline}" Watermark="empty = none" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Default deadline" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Initial deadline for new invocation tabs. Default: none (opt-in)." />
            </StackPanel>

            <!-- ───────── protoc (FR-154) ───────── -->
            <TextBlock Classes="sectionHeader" Text="protoc" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="protoc path override" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="protocPath"
                            AutomationProperties.Name="Reset protoc path" />
                    <TextBox Text="{Binding ProtocPath}" Watermark="empty = use PATH" MinWidth="320"
                             HorizontalAlignment="Left" AutomationProperties.Name="protoc path" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Detect" Command="{Binding DetectProtocCommand}"
                            AutomationProperties.Name="Detect protoc" />
                    <Button Content="Verify" Command="{Binding VerifyProtocCommand}"
                            AutomationProperties.Name="Verify protoc" />
                    <TextBlock Text="{Binding ProtocStatus}" VerticalAlignment="Center" Opacity="0.8"
                               IsVisible="{Binding ProtocStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Classes="settingHint"
                           Text="Explicit protoc used instead of PATH lookup. Detect reports what PATH resolves; Verify runs --version on the override." />
            </StackPanel>

            <!-- ───────── Security (SEC-024): live secret-store backend ───────── -->
            <TextBlock Classes="sectionHeader" Text="Security" IsVisible="{Binding HasSecretBackend}" />

            <StackPanel Spacing="2" IsVisible="{Binding HasSecretBackend}">
                <TextBlock Classes="settingLabel" Text="Secret storage backend" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SecretBackendName}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Conn.Connecting}" CornerRadius="4" Padding="6,1"
                            IsVisible="{Binding SecretBackendIsOsKeychain}">
                        <TextBlock Text="OS keychain" FontSize="11" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="settingHint"
                           Text="Where PKCS12 passwords and secret-typed variables are stored. Secrets are never written to workspace, history, or settings files." />

                <!-- SEC-024: the encrypted-file fallback states its limitation verbatim. -->
                <Border IsVisible="{Binding SecretBackendHasLimitation}" Margin="0,6,0,0" Padding="10"
                        CornerRadius="4" Background="{DynamicResource Banner.DangerBg}"
                        BorderBrush="{DynamicResource Status.Server}" BorderThickness="3,0,0,0">
                    <TextBlock Text="{Binding SecretBackendLimitation}" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>

            <!-- ───────── Phase-2 placeholders (disabled) ───────── -->
            <StackPanel IsEnabled="False" Spacing="6" Opacity="0.55">
                <TextBlock Classes="sectionHeader" Text="Diagnostics" />
                <TextBlock Classes="settingHint" Text="In-app log viewer, level filter, and diagnostics bundle — arrives in a later release." />
                <TextBlock Classes="sectionHeader" Text="Updates" />
                <TextBlock Classes="settingHint" Text="Update channel, check-on-launch, and consent-to-apply — arrives in a later release." />
                <TextBlock Classes="sectionHeader" Text="Descriptor limits" />
                <TextBlock Classes="settingHint" Text="App-wide defaults for descriptor caps — arrives in a later release." />
                <TextBlock Classes="sectionHeader" Text="History" />
                <TextBlock Classes="settingHint" Text="Retention caps and capture toggle — arrives in a later release." />
            </StackPanel>

            <!-- ───────── Reset all (FR-159) ───────── -->
            <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                <Button Content="Reset all settings…" Command="{Binding ResetAllCommand}"
                        AutomationProperties.Name="Reset all settings" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
