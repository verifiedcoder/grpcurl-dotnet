<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:GrpCurl.Net.Studio.ViewModels.Documents;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:diag="clr-namespace:GrpCurl.Net.Studio.ViewModels.Models.Diagnostics;assembly=GrpCurl.Net.Studio.ViewModels"
             x:Class="GrpCurl.Net.Studio.Views.Documents.SettingsDocumentView"
             x:Name="Root"
             x:DataType="docs:SettingsDocumentViewModel">

    <UserControl.Styles>
        <!-- One settings row: label + control + inline description + reset. -->
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.settingHint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="20,14">
        <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Settings" FontWeight="Bold" FontSize="20" />
            <TextBlock Classes="settingHint"
                       Text="Changes apply and save immediately. Each setting can be reset to its default." />

            <!-- ───────── General ───────── -->
            <TextBlock Classes="sectionHeader" Text="General" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Theme" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="theme"
                            AutomationProperties.Name="Reset theme" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Theme" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Light, Dark, or follow the OS (default: System). Applies live." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Startup" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="startup"
                            AutomationProperties.Name="Reset startup" />
                    <ComboBox ItemsSource="{Binding StartupOptions}" SelectedItem="{Binding Startup}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Startup behaviour" />
                </DockPanel>
                <TextBlock Classes="settingHint"
                           Text="Reopen the last workspace and tabs, or start empty (default: Restore last workspace)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="CLI export dialect" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="dialect"
                            AutomationProperties.Name="Reset CLI dialect" />
                    <ComboBox ItemsSource="{Binding DialectOptions}" SelectedItem="{Binding CliShellDialect}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="CLI export dialect" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default shell quoting for &quot;Copy as CLI&quot; (default: Bash)." />
            </StackPanel>

            <!-- ───────── Editor ───────── -->
            <TextBlock Classes="sectionHeader" Text="Editor" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Font family" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="fontFamily"
                            AutomationProperties.Name="Reset font family" />
                    <TextBox Text="{Binding EditorFontFamily}" MinWidth="260" HorizontalAlignment="Left"
                             AutomationProperties.Name="Editor font family" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Applies to all code editors (default: Cascadia Code,Consolas,monospace)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Font size" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="fontSize"
                            AutomationProperties.Name="Reset font size" />
                    <NumericUpDown Value="{Binding EditorFontSize}" Minimum="8" Maximum="32" Increment="1"
                                   MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Editor font size" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Editor text size in points (default: 13)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Indentation width" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="indent"
                            AutomationProperties.Name="Reset indentation width" />
                    <NumericUpDown Value="{Binding EditorIndentWidth}" Minimum="1" Maximum="8" Increment="1"
                                   MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Indentation width" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Spaces per indent for pretty-printed JSON (default: 2)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding EditorFormatOnPaste}" Content="Format on paste"
                          AutomationProperties.Name="Format on paste" />
                <TextBlock Classes="settingHint" Text="Re-indent pasted JSON (default: on)." />
            </StackPanel>

            <!-- ───────── Network defaults ───────── -->
            <TextBlock Classes="sectionHeader" Text="Network defaults" />
            <TextBlock Classes="settingHint"
                       Text="Applied to new connections and invocation tabs as initial values; existing ones are never changed." />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Connect timeout" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="connectTimeout"
                            AutomationProperties.Name="Reset connect timeout" />
                    <TextBox Text="{Binding NetworkConnectTimeout}" Watermark="e.g. 10s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Connect timeout" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Duration grammar (500ms, 10s, 1.5m). Default: 10s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Keepalive time" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="keepaliveTime"
                            AutomationProperties.Name="Reset keepalive time" />
                    <TextBox Text="{Binding NetworkKeepaliveTime}" Watermark="e.g. 60s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Keepalive time" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default: 60s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Keepalive timeout" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="keepaliveTimeout"
                            AutomationProperties.Name="Reset keepalive timeout" />
                    <TextBox Text="{Binding NetworkKeepaliveTimeout}" Watermark="e.g. 30s" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Keepalive timeout" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Default: 30s." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Max message size" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="maxMessageSize"
                            AutomationProperties.Name="Reset max message size" />
                    <TextBox Text="{Binding NetworkMaxMessageSize}" Watermark="e.g. 4MB (empty = client default)"
                             MinWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Max message size" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Empty uses the gRPC client default." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Default deadline" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="defaultDeadline"
                            AutomationProperties.Name="Reset default deadline" />
                    <TextBox Text="{Binding NetworkDefaultDeadline}" Watermark="empty = none" MinWidth="160"
                             HorizontalAlignment="Left" AutomationProperties.Name="Default deadline" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Initial deadline for new invocation tabs. Default: none (opt-in)." />
            </StackPanel>

            <!-- ───────── protoc (FR-154) ───────── -->
            <TextBlock Classes="sectionHeader" Text="protoc" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="protoc path override" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="protocPath"
                            AutomationProperties.Name="Reset protoc path" />
                    <TextBox Text="{Binding ProtocPath}" Watermark="empty = use PATH" MinWidth="320"
                             HorizontalAlignment="Left" AutomationProperties.Name="protoc path" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Detect" Command="{Binding DetectProtocCommand}"
                            AutomationProperties.Name="Detect protoc" />
                    <Button Content="Verify" Command="{Binding VerifyProtocCommand}"
                            AutomationProperties.Name="Verify protoc" />
                    <TextBlock Text="{Binding ProtocStatus}" VerticalAlignment="Center" Opacity="0.8"
                               IsVisible="{Binding ProtocStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Classes="settingHint"
                           Text="Explicit protoc used instead of PATH lookup. Detect reports what PATH resolves; Verify runs --version on the override." />
            </StackPanel>

            <!-- ───────── Security (SEC-024): live secret-store backend ───────── -->
            <TextBlock Classes="sectionHeader" Text="Security" IsVisible="{Binding HasSecretBackend}" />

            <StackPanel Spacing="2" IsVisible="{Binding HasSecretBackend}">
                <TextBlock Classes="settingLabel" Text="Secret storage backend" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SecretBackendName}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Conn.Connecting}" CornerRadius="4" Padding="6,1"
                            IsVisible="{Binding SecretBackendIsOsKeychain}">
                        <TextBlock Text="OS keychain" FontSize="11" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="settingHint"
                           Text="Where PKCS12 passwords and secret-typed variables are stored. Secrets are never written to workspace, history, or settings files." />

                <!-- SEC-024: the encrypted-file fallback states its limitation verbatim. -->
                <Border IsVisible="{Binding SecretBackendHasLimitation}" Margin="0,6,0,0" Padding="10"
                        CornerRadius="4" Background="{DynamicResource Banner.DangerBg}"
                        BorderBrush="{DynamicResource Status.Server}" BorderThickness="3,0,0,0">
                    <TextBlock Text="{Binding SecretBackendLimitation}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <!-- SEC-027: stored-secret audit + cleanup. Lists keyrefs (names only, never values). -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <TextBlock Classes="settingLabel" Text="Stored secrets" VerticalAlignment="Center" />
                    <Button Content="Refresh" Command="{Binding RefreshSecretsCommand}"
                            AutomationProperties.Name="Refresh stored secrets" />
                </StackPanel>
                <TextBlock Classes="settingHint"
                           Text="Keyrefs only (names, never values). Deleting one means any connection or environment using it must have the value re-entered." />
                <TextBlock Text="No secrets stored." Opacity="0.7" Margin="0,2,0,0"
                           IsVisible="{Binding HasNoSecretKeyRefs}" />
                <ItemsControl ItemsSource="{Binding SecretKeyRefs}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding}"
                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Delete" FontSize="11"
                                        Command="{Binding #Root.((docs:SettingsDocumentViewModel)DataContext).DeleteSecretCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Delete stored secret" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ───────── History (FR-158) ───────── -->
            <TextBlock Classes="sectionHeader" Text="History" />

            <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding HistoryCaptureEnabled}" Content="Capture invocation history"
                          AutomationProperties.Name="Capture history" />
                <TextBlock Classes="settingHint" Text="Record every call (redacted) to the History tab (default: on)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding HistoryCaptureResponses}" Content="Capture response bodies"
                          AutomationProperties.Name="Capture response bodies" />
                <TextBlock Classes="settingHint" Text="Store response payloads in history, capped below (default: off)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Max entries" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="historyMaxEntries"
                            AutomationProperties.Name="Reset history max entries" />
                    <NumericUpDown Value="{Binding HistoryMaxEntries}" Minimum="1" Maximum="100000" Increment="100"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="History max entries" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Oldest unpinned entries are evicted past this count (default: 1000)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Max size (MiB)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="historyMaxSize"
                            AutomationProperties.Name="Reset history max size" />
                    <NumericUpDown Value="{Binding HistoryMaxSizeMiB}" Minimum="1" Maximum="4096" Increment="10"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="History max size" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Total history file cap before eviction (default: 50)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Response snapshot cap (KiB)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="historyResponseCap"
                            AutomationProperties.Name="Reset history response cap" />
                    <NumericUpDown Value="{Binding HistoryResponseCapKiB}" Minimum="1" Maximum="16384" Increment="64"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="History response cap" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Per-entry body/response truncation size (default: 256)." />
            </StackPanel>

            <!-- ───────── Descriptor limits (FR-157) ───────── -->
            <TextBlock Classes="sectionHeader" Text="Descriptor limits" />
            <TextBlock Classes="settingHint"
                       Text="App-wide caps on descriptor loading. A connection's own override (in its Limits expander) wins; otherwise these apply, falling back to the Core default." />

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="settingLabel" Text="Protoset file cap (MiB)" />
                    <TextBlock Text="(changed)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Conn.Connecting}"
                               IsVisible="{Binding DescriptorMaxProtosetMiBChanged}" />
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="descriptorProtoset"
                            AutomationProperties.Name="Reset protoset cap" />
                    <NumericUpDown Value="{Binding DescriptorMaxProtosetMiB}" Minimum="1" Maximum="4096" Increment="16"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Protoset file cap" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Core default: 64 MiB." />
            </StackPanel>

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="settingLabel" Text="Reflection descriptor cap (MiB)" />
                    <TextBlock Text="(changed)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Conn.Connecting}"
                               IsVisible="{Binding DescriptorMaxReflectionMiBChanged}" />
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="descriptorReflection"
                            AutomationProperties.Name="Reset reflection cap" />
                    <NumericUpDown Value="{Binding DescriptorMaxReflectionMiB}" Minimum="1" Maximum="4096" Increment="8"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Reflection descriptor cap" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Core default: 16 MiB." />
            </StackPanel>

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="settingLabel" Text="Max file descriptors" />
                    <TextBlock Text="(changed)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Conn.Connecting}"
                               IsVisible="{Binding DescriptorMaxFileDescriptorsChanged}" />
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="descriptorFiles"
                            AutomationProperties.Name="Reset max file descriptors" />
                    <NumericUpDown Value="{Binding DescriptorMaxFileDescriptors}" Minimum="1" Maximum="1000000" Increment="256"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Max file descriptors" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Core default: 2048." />
            </StackPanel>

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="settingLabel" Text="Max dependency depth" />
                    <TextBlock Text="(changed)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Conn.Connecting}"
                               IsVisible="{Binding DescriptorMaxDependencyDepthChanged}" />
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="descriptorDepth"
                            AutomationProperties.Name="Reset max dependency depth" />
                    <NumericUpDown Value="{Binding DescriptorMaxDependencyDepth}" Minimum="1" Maximum="100000" Increment="16"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Max dependency depth" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Core default: 128." />
            </StackPanel>

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="settingLabel" Text="Max symbols" />
                    <TextBlock Text="(changed)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Conn.Connecting}"
                               IsVisible="{Binding DescriptorMaxSymbolsChanged}" />
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="descriptorSymbols"
                            AutomationProperties.Name="Reset max symbols" />
                    <NumericUpDown Value="{Binding DescriptorMaxSymbols}" Minimum="1" Maximum="100000000" Increment="1024"
                                   MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Max symbols" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Core default: 65536." />
            </StackPanel>

            <!-- ───────── Updates (FR-156) ───────── -->
            <TextBlock Classes="sectionHeader" Text="Updates" />

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Version" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check now" Margin="8,0,0,0"
                            Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="Check for updates" />
                    <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="settingHint" TextWrapping="Wrap"
                           Text="Studio does not auto-update; Check now compares your version against the latest release and, if newer, lets you open it to download and install with consent (ADR-011)." />
                <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Opacity="0.8" Margin="0,2,0,0"
                           IsVisible="{Binding UpdateStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="Open release page" Margin="0,4,0,0"
                        Command="{Binding OpenLatestReleaseCommand}" IsVisible="{Binding UpdateAvailable}"
                        AutomationProperties.Name="Open the latest release page" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="settingLabel" Text="Release channel" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0"
                            Command="{Binding ResetSettingCommand}" CommandParameter="updateChannel"
                            AutomationProperties.Name="Reset release channel" />
                    <ComboBox ItemsSource="{Binding UpdateChannelOptions}" SelectedItem="{Binding UpdateChannel}"
                              MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Release channel" />
                </DockPanel>
                <TextBlock Classes="settingHint" Text="Stable opens the latest release; Preview opens all releases (default: Stable)." />
            </StackPanel>

            <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding UpdateCheckOnLaunch}" Content="Check for updates on launch"
                          AutomationProperties.Name="Check for updates on launch" />
                <TextBlock Classes="settingHint" Text="Remembered for when automatic update checks arrive (default: on)." />
            </StackPanel>

            <!-- ───────── Diagnostics (FR-155) ───────── -->
            <TextBlock Classes="sectionHeader" Text="Diagnostics" />
            <StackPanel Spacing="6" IsVisible="{Binding HasDiagnostics}">
                <TextBlock Classes="settingHint"
                           Text="The rolling diagnostics log (7-day / 10 MB). Header values are never logged; the bundle contains no workspace content or secrets." />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding DiagnosticsLevelOptions}"
                              SelectedItem="{Binding DiagnosticsLevelFilter}" MinWidth="120"
                              AutomationProperties.Name="Diagnostics level filter" />
                    <TextBox Grid.Column="1" Text="{Binding DiagnosticsSearch}" Watermark="Search…"
                             AutomationProperties.Name="Diagnostics search" />
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}"
                            AutomationProperties.Name="Refresh diagnostics" />
                </Grid>

                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="4"
                        Background="{DynamicResource Surface.PaneHeader}" Padding="6" MinHeight="120">
                    <ScrollViewer MaxHeight="320">
                        <Panel>
                            <TextBlock Text="No matching log entries." Opacity="0.6" FontSize="12"
                                       IsVisible="{Binding HasNoDiagnosticsEntries}" />
                            <ItemsControl ItemsSource="{Binding DiagnosticsEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diag:DiagnosticsLogEntry">
                                        <TextBlock FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,1">
                                            <Run Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}" />
                                            <Run Text=" " /><Run Text="{Binding Level}" FontWeight="SemiBold" />
                                            <Run Text="  " /><Run Text="{Binding Category}" Foreground="{DynamicResource Status.Neutral}" />
                                            <Run Text=" — " /><Run Text="{Binding Message}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                            AutomationProperties.Name="Open log folder" />
                    <Button Content="Copy diagnostics bundle" Command="{Binding CopyDiagnosticsBundleCommand}"
                            AutomationProperties.Name="Copy diagnostics bundle" />
                    <TextBlock Text="{Binding DiagnosticsStatus}" VerticalAlignment="Center" Opacity="0.8" FontSize="12"
                               IsVisible="{Binding DiagnosticsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </StackPanel>

            <!-- ───────── Reset all (FR-159) ───────── -->
            <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                <Button Content="Reset all settings…" Command="{Binding ResetAllCommand}"
                        AutomationProperties.Name="Reset all settings" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
