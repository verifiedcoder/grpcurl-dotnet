<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GrpCurl.Net.Studio.ViewModels;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:conv="clr-namespace:GrpCurl.Net.Studio.Converters"
             x:Class="GrpCurl.Net.Studio.Views.ImportSecretsDialogView"
             x:DataType="vm:ImportSecretsDialogViewModel"
             Width="520">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Supply imported secrets" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="These secrets aren't part of the workspace file — only their references are. Enter a value to store it locally now, or skip and supply it later in the relevant editor." />

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportSecretRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding DisplayName}"
                                   FontWeight="SemiBold" FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Value}" Watermark="Enter value (optional)"
                                 PasswordChar="{Binding !IsRevealed, Converter={x:Static conv:SecretMaskConverter.Instance}}"
                                 AutomationProperties.Name="Secret value" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Show" IsChecked="{Binding IsRevealed}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Reveal value" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Skip for now" Command="{Binding SkipCommand}" MinWidth="100"
                    AutomationProperties.Name="Skip supplying secrets" />
            <Button Content="Store secrets" Command="{Binding ApplyCommand}" MinWidth="100" IsDefault="True"
                    AutomationProperties.Name="Store supplied secrets" />
        </StackPanel>
    </StackPanel>
</UserControl>
