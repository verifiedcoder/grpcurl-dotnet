<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GrpCurl.Net.Studio.ViewModels.Panes;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:items="clr-namespace:GrpCurl.Net.Studio.ViewModels.Connections;assembly=GrpCurl.Net.Studio.ViewModels"
             xmlns:conv="clr-namespace:GrpCurl.Net.Studio.Converters"
             x:Class="GrpCurl.Net.Studio.Views.Panes.ConnectionsPaneView"
             x:DataType="vm:ConnectionsPaneViewModel">
    <UserControl.Resources>
        <conv:ConnectionStatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource Surface.PaneHeader}" Padding="8,6">
            <DockPanel>
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="+" Command="{Binding AddConnectionCommand}" Padding="6,0"
                            ToolTip.Tip="Add connection" AutomationProperties.Name="Add connection" />
                    <Button Content="✎" Command="{Binding EditConnectionCommand}" Padding="6,0"
                            ToolTip.Tip="Edit connection" AutomationProperties.Name="Edit connection" />
                    <Button Content="⧉" Command="{Binding DuplicateConnectionCommand}" Padding="6,0"
                            ToolTip.Tip="Duplicate connection" AutomationProperties.Name="Duplicate connection" />
                    <Button Content="✕" Command="{Binding DeleteConnectionCommand}" Padding="6,0"
                            ToolTip.Tip="Delete connection" AutomationProperties.Name="Delete connection" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Connections}"
                 SelectedItem="{Binding SelectedConnection}"
                 AutomationProperties.Name="Connections list">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="items:ConnectionListItemViewModel">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <!-- FR-166: import a saved-request snippet into this connection. -->
                        <Grid.ContextMenu>
                            <ContextMenu x:DataType="items:ConnectionListItemViewModel">
                                <MenuItem Header="New GraphQL operation"
                                          Command="{Binding $parent[ListBox].((vm:ConnectionsPaneViewModel)DataContext).NewGraphQlOperationCommand}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="New GraphQL operation" />
                                <MenuItem Header="Import request…" Command="{Binding ImportRequestCommand}"
                                          AutomationProperties.Name="Import request into connection" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,3,8,0"
                                 Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                 ToolTip.Tip="{Binding StatusDetail}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Address}" Opacity="0.6" FontSize="12" />

                            <!-- FR-145: the connection's saved requests, nested and openable into a tab. -->
                            <ItemsControl ItemsSource="{Binding SavedRequests}" IsVisible="{Binding HasSavedRequests}"
                                          Margin="2,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="items:SavedRequestItemViewModel">
                                        <Button Command="{Binding OpenCommand}" Padding="6,2" Margin="0,1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                AutomationProperties.Name="Open saved request"
                                                ToolTip.Tip="{Binding MethodShortName}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="▸" Opacity="0.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                            <!-- FR-145: rename / duplicate / delete a saved request. -->
                                            <Button.ContextMenu>
                                                <ContextMenu x:DataType="items:SavedRequestItemViewModel">
                                                    <MenuItem Header="Open" Command="{Binding OpenCommand}"
                                                              AutomationProperties.Name="Open saved request" />
                                                    <MenuItem Header="Rename…" Command="{Binding RenameCommand}"
                                                              AutomationProperties.Name="Rename saved request" />
                                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"
                                                              AutomationProperties.Name="Duplicate saved request" />
                                                    <MenuItem Header="Export…" Command="{Binding ExportCommand}"
                                                              AutomationProperties.Name="Export saved request" />
                                                    <Separator />
                                                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                                                              AutomationProperties.Name="Delete saved request" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
