<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GrpCurl.Net.Studio.ViewModels.Panes;assembly=GrpCurl.Net.Studio.ViewModels"
             x:Class="GrpCurl.Net.Studio.Views.Panes.ConsoleView"
             x:DataType="vm:ConsoleViewModel">
    <Border Background="{DynamicResource Surface.ConsoleBg}">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource Surface.PaneHeader}" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- FR-003: unread activity that arrived while the console was collapsed. -->
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource Conn.Connecting}" IsVisible="{Binding HasUnread}"
                             ToolTip.Tip="New activity" />
                </StackPanel>
            </Border>

            <Panel Grid.Row="1">
                <TextBlock Margin="8" Opacity="0.6" IsVisible="{Binding !HasActivity}"
                           Text="Activity and timing will appear here." />

                <!-- FR-114: completed calls, selectable to reveal the phase breakdown in the inspector. -->
                <ListBox ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}"
                         IsVisible="{Binding HasActivity}" AutomationProperties.Name="Call activity"
                         Background="Transparent">
                    <ListBox.Styles>
                        <Style Selector="TextBlock.error">
                            <Setter Property="Foreground" Value="{DynamicResource Status.Server}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ConsoleCallRowViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                  TextElement.FontFamily="Cascadia Code,Consolas,monospace" TextElement.FontSize="12">
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Opacity="0.55" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Opacity="0.7" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Status.Neutral}" />
                                <TextBlock Grid.Column="2" Text="{Binding Method}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusName}" Margin="8,0"
                                           Classes.error="{Binding IsError}" />
                                <TextBlock Grid.Column="4" Text="{Binding TotalText}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Grid>
    </Border>
</UserControl>
